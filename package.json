{
  "name": "sonarqube-webapp",
  "version": "0.0.0",
  "description": "Monorepository for the SonarQube WebApp",
  "license": "LGPL-3.0",
  "workspaces": [
    "apps/sq-server",
    "private/apps/sq-cloud",
    "private/sq-cloud-e2e-tests",
    "private/sq-cloud-metrics",
    "tools/nx-automation"
  ],
  "engines": {
    "node": ">=20.19.1 <21 || >=22.15 <23.12"
  },
  "packageManager": "yarn@4.17.0",
  "browserslist": [
    "defaults and supports es6-module",
    "Chrome >= 66",
    "Edge >= 88",
    "Firefox >= 78",
    "Safari >= 12"
  ],
  "nx": {
    "includedScripts": [
      "dep-check",
      "format-check",
      "knip",
      "knip:report",
      "test-eslint-local-rules",
      "test-knip-report"
    ]
  },
  "scripts": {
    "build": "yarn nx run-many -t build",
    "build-analyze": "yarn nx run-many -t build-analyze",
    "bundle": "yarn nx run-many -t bundle",
    "clean": "yarn nx run-many -t clean",
    "dep-check": "node ./config/validate-package-json.js ./package.json && ./config/no-repox-ref-in-yarn-lock.sh -c ./yarn.lock",
    "format": "yarn nx run-many -t format-check --write",
    "format-check": "yarn prettier --check \"./{,@types,config,eslint-local-rules}/*.{js,json,ts,tsx}\"",
    "lint": "yarn nx run-many -t lint --quiet",
    "lint-report": "yarn nx run-many -t lint-report",
    "new-shared-lib": "yarn nx g shared-library",
    "e2e-show-gh-report": "bash ./private/config/e2e-show-gh-report.sh",
    "start-sqc": "yarn nx start sq-cloud",
    "start-sqc-w-mocks": "yarn nx start-w-mocks sq-cloud",
    "start-sqs": "yarn nx start sq-server",
    "start-sqs-w-mocks": "yarn nx start-w-mocks sq-server",
    "test": "yarn nx run-many -t test",
    "test-eslint-local-rules": "yarn jest -c eslint-local-rules/test-config/jest.config.js",
    "ts-check": "yarn nx run-many -t ts-check",
    "validate": "yarn nx run-many -t validate",
    "validate-l10n": "node private/config/validate-l10n.mts",
    "scan-components": "node tools/scan-components/index.mjs",
    "track-adoption": "node tools/scan-components/track-adoption.mjs",
    "ld-attribute-check": "node private/config/analyze-ld-context-attributes.mts",
    "knip": "NX_DAEMON=false knip",
    "knip:report": "NX_DAEMON=false knip --reporter ./config/knip/knip-sonarqube-reporter.ts --no-config-hints --no-exit-code",
    "test-knip-report": "yarn jest -c eslint-local-rules/test-config/jest.config.js config/knip/__tests__/knip-sonarqube-reporter-test.ts"
  },
