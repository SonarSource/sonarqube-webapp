{
  "name": "sq-server-openapi-community",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/sq-server-openapi-community/src",
  "projectType": "library",
  "tags": ["type:util", "visibility:public", "scope:server"],
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "node {projectRoot}/generate-client.mjs"
      },
      "cache": false
    },
    "format-check": {},
    "format-write": {},
    "lint": {
      "options": {
        "command": "oxlint --quiet {projectRoot}/src/runtime.ts {projectRoot}/src/__tests__"
      }
    },
    "lint-report": {
      "options": {
        "command": "node config/oxlint/lint-report.mjs --output-file {projectRoot}/build/reports/eslint-report/eslint-report.json {projectRoot}/src/runtime.ts {projectRoot}/src/__tests__"
      }
    },
    "ts-check": {}
  }
}
