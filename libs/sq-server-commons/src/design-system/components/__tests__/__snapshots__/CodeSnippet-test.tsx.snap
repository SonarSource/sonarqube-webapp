  -moz-osx-font-smoothing: grayscale;
  -webkit-font-smoothing: antialiased;
  display: inline-block;
  font-size: calc(1em + 4px);
  font-style: normal;
  font-weight: normal;
  height: calc(2em - 16px);
  line-height: calc(2em - 16px);
  text-align: center;
  vertical-align: bottom;
  width: calc(2em - 16px);
  font-family: 'Material Symbols Rounded';
}

.emotion-9 {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.emotion-9.emotion-9 * {
  text-wrap: nowrap;
}

.emotion-11.code-wrap {
  display: block;
  padding-block: var(--echoes-dimension-space-50, 0.25rem);
  white-space: pre-wrap;
  word-break: break-all;
}

.emotion-11.code-wrap.wrap-words {
  overflow-wrap: break-word;
  word-break: normal;
}

.emotion-11.code-wrap.simple-one-line,
.code-snippet-simple-oneline .emotion-11.code-wrap {
  display: inline;
  padding-block: 0;
}

.emotion-11.simple-one-line,
.code-snippet-simple-oneline .emotion-11 {
  min-height: var(--echoes-dimension-height-500, 1.25rem);
  padding-block: 0;
  padding-inline: var(--echoes-dimension-space-50, 0.25rem);
}

.emotion-11 code {
  background: var(--echoes-color-code-background-default);
  color: var(--echoes-color-code-text-default);
  font: var(--echoes-typography-code-default);
}

.emotion-11 code.hljs {
  padding: unset;
}

.emotion-11 .hljs-meta,
.emotion-11 .hljs-variable {
  color: var(--echoes-color-code-text-default);
}

.emotion-11 .hljs-doctag,
.emotion-11 .hljs-title,
.emotion-11 .hljs-title.class_,
.emotion-11 .hljs-title.function_ {
  color: var(--echoes-color-code-text-annotation);
}

.emotion-11 .hljs-comment {
  color: var(--echoes-color-code-text-comment);
  font: var(--echoes-typography-code-comment);
}

.emotion-11 .hljs-keyword,
.emotion-11 .hljs-tag,
.emotion-11 .hljs-type {
  color: var(--echoes-color-code-text-keyword);
  font: var(--echoes-typography-code-highlight);
}

.emotion-11 .hljs-literal,
.emotion-11 .hljs-number {
  color: var(--echoes-color-code-text-constant);
}

.emotion-11 .hljs-string {
  color: var(--echoes-color-code-text-string);
}

.emotion-11 .hljs-meta .hljs-keyword {
  color: var(--echoes-color-code-text-preprocessing-directive);
}

.emotion-11 .sonar-underline {
  position: relative;
  -webkit-text-decoration: underline var(--code-viewer-issue-squiggle);
  text-decoration: underline var(--code-viewer-issue-squiggle);
  -webkit-text-decoration: underline var(--code-viewer-issue-squiggle) wavy;
  text-decoration: underline var(--code-viewer-issue-squiggle) wavy;
  text-decoration-skip-ink: none;
  text-decoration-thickness: 2px;
}

.emotion-11 mark {
  background-color: var(--echoes-color-code-background-highlight);
  border-radius: var(--echoes-border-radius-200, 0.25rem);
  color: var(--echoes-color-code-text-highlight);
  font-weight: var(--echoes-font-weight-regular);
  padding: var(--echoes-dimension-space-50, 0.25rem);
}

<div>
  <div
    class="sw:code code-snippet-with-copy fs-mask emotion-0 emotion-1"
  >
    <button
      class="sw:select-none emotion-2 emotion-3 emotion-4"
      data-state="closed"
      type="button"
    >
      <span
        class="emotion-5 emotion-6"
      >
        <span
          aria-hidden="true"
          class="emotion-7 emotion-8"
        >
          
        </span>
        <span
          class="emotion-9 emotion-10"
        >
          copy
        </span>
      </span>
    </button>
    <div
      class="hljs sw:overflow-auto emotion-11 emotion-12"
    >
      <pre>
        &lt;prop&gt;foobar&lt;prop&gt;
      </pre>
    </div>
  </div>
  <section
    aria-atomic="false"
    aria-label="toasts.keyboard_shortcut_aria_label alt+T"
    aria-live="polite"
    aria-relevant="additions text"
    tabindex="-1"
  />
</div>
`;
